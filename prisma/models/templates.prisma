// Template catalog and user bookmarks.
model TemplateCategory {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  templates Template[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Template {
  id             String         @id @default(uuid())
  categoryId     String
  organizationId String?
  title          String
  description    String?
  status         TemplateStatus @default(DRAFT)
  accessLevel    AccessLevel    @default(FREE)
  aspectRatio    String         @default("4:5")
  width          Int            @default(1080)
  height         Int            @default(1350)

  // Validate this JSON against a server-side schema. Never execute arbitrary user HTML/JS.
  config         Json
  previewAssetId String?
  preview        Asset?           @relation("TemplatePreview", fields: [previewAssetId], references: [id], onDelete: SetNull)
  category       TemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bookmarks      Bookmark[]
  posters        Poster[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  archivedAt     DateTime?

  @@index([status, accessLevel, categoryId])
  @@index([organizationId, status])
}

model Bookmark {
  userId     String
  templateId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, templateId])
  @@index([templateId])
}

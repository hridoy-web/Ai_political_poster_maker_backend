enum MoneyEntryType {
  DEPOSIT
  WITHDRAWAL
  PACKAGE_PURCHASE
  REFUND
}

enum CreditEntryType {
  PURCHASE
  GRANT
  RESERVE
  SETTLE
  REFUND
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  packageId         String?
  subscriptionId    String?
  provider          String        // e.g., "SSLCOMMERZ"
  tranId            String        @unique // SSLCommerz Unique Tran ID
  providerReference String?       // SSLCommerz val_id or bank_tran_id
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("BDT")
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String        @unique
  verifiedAt        DateTime?
  metadata          Json?

  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  package      Package?              @relation(fields: [packageId], references: [id], onDelete: SetNull)
  subscription Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  webhookEvents PaymentWebhookEvent[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([provider, providerReference])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid())
  paymentId       String?
  provider        String
  providerEventId String
  signatureValid  Boolean
  payloadHash     String
  status          String    @default("PROCESSED") // PROCESSED / FAILED / IGNORED
  processedAt     DateTime?

  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([provider, providerEventId])
}
// AI and image-editing task records.
model AiTask {
  id             String        @id @default(uuid())
  userId         String?
  guestSessionId String?
  type           AiTaskType
  status         AiTaskStatus  @default(PENDING)
  provider       String?
  model          String?
  input          Json?
  result         Json?
  errorCode      String?
  unitsCharged   Int           @default(0)
  idempotencyKey String        @unique
  user           User?         @relation("UserAiTasks", fields: [userId], references: [id], onDelete: SetNull)
  guestSession   GuestSession? @relation("GuestAiTasks", fields: [guestSessionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  @@index([userId, type, createdAt])
  @@index([guestSessionId, type, createdAt])
}
